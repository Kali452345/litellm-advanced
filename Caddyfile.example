# Copy to ./Caddyfile and edit the addresses, then bring the stack up with
# `docker compose -f docker-compose.prod.yml --profile tls up -d`

# A browser sends no SNI when the address bar holds an IP, so name the IP site here
# or Caddy has nothing to choose a certificate by and the handshake fails. Drop the
# block when every address below is a hostname.
{
	default_sni 203.0.113.10
}

# A hostname pointed at this server gets a real certificate over HTTP-01, so
# no browser warning. Delete this block if you do not have one.
litellm.example.com {
	reverse_proxy litellm:4000
}

# A bare IP cannot pass HTTP-01, so Caddy signs it with its own root instead.
# The traffic is encrypted, and the browser warns once about the unknown CA.
https://203.0.113.10 {
	tls internal
	reverse_proxy litellm:4000
}
