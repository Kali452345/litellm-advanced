general_settings:
  store_model_in_db: true

router_settings:
  # never park a deployment: a parked one is an instant 429 for the only IP, and
  # the gateway hands out long Retry-After windows
  disable_cooldowns: true
  enable_quota_routing: true
  quota_max_wait_seconds: 75
  # ocproxy walks its own egress pool; keep router retries shallow so a request
  # does not multiply into hundreds of upstream calls.
  num_retries: 1
  fallbacks:
    - deepseek-v4.1-flash-free: ["GLM-5.3", "deepseek-v4.1-flash-paid"]

litellm_settings:
  drop_params: true
  # off: a truncated reply would be cached and replayed to every retry
  cache: true
  cache_params:
    type: local
    ttl: 120

# Free OpenCode models, served by the ocproxy sidecar. The sidecar supplies the
# fingerprint and the rotating egress IPs; LiteLLM only sees a plain
# OpenAI-compatible endpoint. OC_KEY is the shared bearer between the two.
model_list:
  # only free model enabled for this deployment
  - model_name: deepseek-v4.1-flash-free
    litellm_params:
      model: openai/deepseek-v4.1-flash-free
      api_base: http://ocproxy:8788/v1
      api_key: os.environ/OC_KEY
      timeout: 180
      stream_timeout: 180
    model_info:
      mode: chat

  # same model on the Render relay's egress IP: anonymous quota is per IP, so a
  # second deployment is a second allowance and the router fails across them
  - model_name: deepseek-v4.1-flash-free
    litellm_params:
      model: openai/deepseek-v4.1-flash-free
      api_base: https://ocproxy-egress-1.onrender.com/v1
      api_key: os.environ/RENDER_OC_KEY
      timeout: 180
      stream_timeout: 180
    model_info:
      mode: chat

  # Paid endpoint; prefix-cached upstream. Fallback target for the free route.
  - model_name: deepseek-v4.1-flash-paid
    litellm_params:
      model: openai/deepseek-v4.1-flash-1017
      api_base: https://api.experientiallabs.ai/v1
      api_key: os.environ/EXP_KEY
      timeout: 300
      stream_timeout: 300
    model_info:
      mode: chat
